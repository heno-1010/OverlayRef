<Window x:Class="OverlayRef.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OverlayRef"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="450"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" WindowStyle="None"
        AllowsTransparency="True">
    <Grid Background="#84a2d4">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="画像を開く" Click="OpenImage_Click"/>
                <MenuItem Header="閉じる" Click="Close_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>
        
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Text="右クリックで画像を開く" Foreground="White" FontWeight="Bold"/>
    </Grid>
</Window>
