<Window x:Class="OverlayRef.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OverlayRef"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="450"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" WindowStyle="None"
        Topmost="True" SizeChanged="Window_SizeChanged">
    <Grid>
        <Grid Background="#84a2d4" x:Name="NotImageGrid" Visibility="Visible">
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="画像を開く" Click="OpenImage_Click"/>
                    <MenuItem Header="閉じる" Click="Close_Click"/>
                </ContextMenu>
            </Grid.ContextMenu>

            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Text="右クリックで画像を開く" Foreground="White" FontWeight="Bold"/>
        </Grid>
        <Grid x:Name="ImageGrid" Visibility="Collapsed">
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="画像を開く" Click="OpenImage_Click"/>
                    <MenuItem Header="閉じる" Click="Close_Click"/>
                </ContextMenu>
            </Grid.ContextMenu>

            <Canvas x:Name="ImageCanvas" ClipToBounds="True">
                <Image x:Name="ImageControl" Source="{Binding ImageSource}"        MouseDown="Image_MouseDown"
       MouseMove="Image_MouseMove"
       MouseUp="Image_MouseUp"
       MouseLeave="Image_MouseUp"
       MouseWheel="Image_MouseWheel" Stretch="Fill">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
                            <TranslateTransform X="{Binding OffsetX}" Y="{Binding OffsetY}" />
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
            </Canvas>
        </Grid>
    </Grid>
</Window>
